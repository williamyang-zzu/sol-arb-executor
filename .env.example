# Solana RPC endpoint used for read-only transaction simulation.
RPC_URL=https://api.mainnet-beta.solana.com
# Local signer path. Never commit this file or the referenced wallet.
WALLET_PATH=/absolute/path/to/wallet.json
TARGET_MINT=
PUMP_POOL=
METEORA_POOL=
USER_WSOL_ACCOUNT=
USER_TOKEN_ACCOUNT=
# JSON file produced by your account discovery tooling. See README.
ROUTE_ACCOUNTS_FILE=
# Address lookup table containing the fixed route and pool accounts. The route
# plus compute-budget instruction does not fit in a legacy transaction.
ADDRESS_LOOKUP_TABLE=
WSOL_AMOUNT_IN=
# Minimum gross WSOL profit enforced atomically by the on-chain program.
MIN_PROFIT_LAMPORTS=
METEORA_BIN_ARRAYS=
# Simulation is the default. Sending requires the exact literal value true.
SEND_REAL_TRANSACTION=false

# mainnet-smoke.ts repeated sender. Every transaction is independently built,
# signed, and broadcast; it does not wait for confirmation before the next one.
# TRANSACTION_COUNT=0 keeps the original two-route simulation behavior.
TRANSACTION_COUNT=0
TRANSACTION_INTERVAL_MS=3000
# pump-to-meteora, meteora-to-pump, or alternate. Alternate starts forward.
TRANSACTION_DIRECTION=pump-to-meteora
# Sender output consumed by the separate mainnet-smoke-monitor.ts process.
# If omitted, the sender creates a timestamped file under target/.
BROADCAST_MANIFEST_FILE=
# Separate monitor settings. The result file must differ from the manifest.
MONITOR_POLL_MS=1000
MONITOR_REPORT_FILE=
