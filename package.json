{
  "name": "sol-arb-executor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "anchor build",
    "fmt": "cargo fmt --all -- --check && prettier --check \"{scripts,tests}/**/*.ts\"",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "test": "npm run test:rust && npm run test:ts",
    "test:rust": "cargo test --workspace",
    "test:ts": "tsc --outDir target/ts-tests && mocha -t 10000 \"target/ts-tests/tests/instruction-construction.spec.js\" \"target/ts-tests/tests/sender-pipeline.spec.js\"",
    "test:integration": "bash scripts/run-local-integration.sh",
    "test:integration:client": "tsc --outDir target/ts-integration && mocha -t 120000 \"target/ts-integration/tests/integration/local-validator.spec.js\"",
    "test:surfpool-real": "anchor build && mocha --exit -r ts-node/register -t 180000 tests/integration/surfpool-real.spec.ts",
    "test:surfpool-fixed-direction": "anchor build && mocha --exit -r ts-node/register -t 180000 --grep 'fixed-direction succeeds' tests/integration/surfpool-real.spec.ts",
    "test:surfpool-best-direction": "anchor build && mocha --exit -r ts-node/register -t 180000 --grep 'best-direction selects' tests/integration/surfpool-real.spec.ts",
    "test:surfpool-cu-budget": "anchor build && mocha --exit -r ts-node/register -t 180000 --grep 'controlled real-protocol state' tests/integration/surfpool-real.spec.ts",
    "test:mainnet-milestones": "mocha --exit -r ts-node/register -t 60000 tests/integration/mainnet-milestones.spec.ts",
    "test:quote-parity": "cargo test --manifest-path test-programs/quote-probe/Cargo.toml && mocha --exit -r ts-node/register -t 60000 tests/quote-parity.spec.ts",
    "test:quote-cu": "bash scripts/run-quote-probe-cu.sh",
    "capture:quote-snapshot": "ts-node scripts/capture-quote-parity-snapshot.ts",
    "typecheck": "tsc --noEmit",
    "simulate:pump-to-meteora": "ts-node scripts/simulate-pump-to-meteora.ts",
    "simulate:meteora-to-pump": "ts-node scripts/simulate-meteora-to-pump.ts",
    "smoke:mainnet": "ts-node scripts/mainnet-smoke.ts",
    "monitor:mainnet": "ts-node scripts/mainnet-smoke-monitor.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@meteora-ag/dlmm": "1.9.14",
    "@solana/spl-token": "0.4.13",
    "@solana/web3.js": "1.98.4",
    "dotenv": "16.6.1"
  },
  "devDependencies": {
    "@pump-fun/pump-sdk": "1.36.0",
    "@pump-fun/pump-swap-sdk": "1.19.0",
    "@solana/surfpool": "1.5.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.17.0",
    "chai": "4.5.0",
    "mocha": "10.8.2",
    "prettier": "3.6.2",
    "ts-mocha": "10.0.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "overrides": {
    "rpc-websockets": "9.2.0"
  }
}
